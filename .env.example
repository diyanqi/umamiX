# Production should point at your externally managed PostgreSQL, not a container
DATABASE_URL="postgresql://infvar:infvar@your-db-host:5432/infvar?schema=public"
REDIS_URL="redis://localhost:6379"

AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-32-byte-random-secret"
NEXTAUTH_SECRET="replace-with-the-same-32-byte-random-secret"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# capjs-core proof-of-work signing key, at least 16 bytes
CAP_SECRET="replace-with-a-long-random-proof-of-work-secret"

APP_URL="http://localhost:3000"

# OpenAI-compatible AI provider (optional until configured)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# WeChat OpenClaw protocol notification endpoint (optional until configured)
CLAWDBOT_WEBHOOK_URL=""

WORKER_CONCURRENCY="4"
TRACKING_RATE_LIMIT_PER_MINUTE="600"

# Billing: "mock" works without external services; "stripe" requires keys
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
