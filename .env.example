# ===== 基础部署 =====
# 生产环境请指向服务器外部管理的 PostgreSQL，不要使用容器数据库
DATABASE_URL="postgresql://infvar:infvar@your-db-host:5432/infvar?schema=public"
# 生产 compose 默认使用容器内 redis://redis:6379；外部 Redis 需同时改 compose
REDIS_URL="redis://localhost:6379"

# 对外访问地址，生产必须改成 https://analytics.infvar.com
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# 用 openssl rand -base64 32 生成，两个值保持相同
AUTH_SECRET="replace-with-a-32-byte-random-secret"
NEXTAUTH_SECRET="replace-with-the-same-32-byte-random-secret"

# GitHub OAuth App 配置
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# CAP Proof-of-Work 签名密钥，至少 16 字节，单独生成一个
CAP_SECRET="replace-with-a-long-random-proof-of-work-secret"

# 对外暴露端口，默认 3000
PORT="3000"

# ===== AI 洞察（可选） =====
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ===== 通知（可选） =====
# 微信 OpenClaw / clawdbot Webhook
CLAWDBOT_WEBHOOK_URL=""

# ===== Worker / 限流 =====
WORKER_CONCURRENCY="4"
TRACKING_RATE_LIMIT_PER_MINUTE="600"

# ===== 计费 =====
# mock：本地/自托管直接切换；stripe：接入 Stripe Checkout
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
